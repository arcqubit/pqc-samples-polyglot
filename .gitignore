# Local scanner builds and reports; retain the Linux binary used in CI.
/tools/cryptoscan/*
!/tools/cryptoscan/cryptoscan-linux-amd64
!/tools/cryptoscan/checksums-linux.txt
!/tools/cryptoscan/LICENSE
!/tools/cryptoscan/README.md
/.cryptoscan-baseline/
/reports/
/scan-results/
/findings.json
/findings.sarif
/polyglot-findings.*

# Python helper caches.
__pycache__/
*.py[cod]
