# Local scanner builds and reports; retain the Linux binary used in CI.
/tools/aqb-openscan-cli/*
!/tools/aqb-openscan-cli/aqb-openscan-cli-linux-amd64
!/tools/aqb-openscan-cli/checksums-linux.txt
!/tools/aqb-openscan-cli/README.md
/.aqb-openscan-baseline/
/reports/
/scan-results/
/findings.json
/findings.sarif
/polyglot-findings.*

# Python helper caches.
__pycache__/
*.py[cod]
